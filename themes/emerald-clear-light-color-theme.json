  "semanticHighlighting": true,
  "semanticTokenColors": {
    "function": "#346E83",
    "method": "#346E83",
    "class": "#77618B",
    "type": "#77618B",
    "string": "#65783D",
    "number": "#8A6736",
    "keyword": "#1F6F5F",
    "comment": "#738078"
  },
  "tokenColors": [
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#738078"
      }
    },
    {
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#1F6F5F"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#65783D"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#8A6736"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#77618B"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#346E83"
      }
    },
    {
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#293E37"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#1F6F5F"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#8A6736"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#1F6F5F"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#AB4858"
      }
    }
  ]
